; Godot on gasm: 3D with the Compatibility renderer (OpenGL ES 3 on gasm:gl):
; a procedural sky, shadows, PBR materials, a custom shader with a varying, 3D physics.
config_version=5

[application]
; gasm shows its own splash while loading: no second one from Godot
boot_splash/show_image=false

config/name="3D scene (Godot on gasm)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor]

; text scenes in the pack: binary conversion gives nodes random ids, so exports would differ
export/convert_text_resources_to_binary=false
